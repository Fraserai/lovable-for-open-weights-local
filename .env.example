# Copy to .env and fill in. Never commit .env. Production values: see DEPLOY.md.

# --- Weightroom hosted service (worker/src/weightroom) -------------------------------------------
# Leave these unset to run everything locally: SQLite, files on disk, and a fake trainer that spends nothing.
# DATABASE_URL=postgresql://user:pass@host:5432/weightroom
# DATA_DIR=./wr-data
# PUBLIC_BASE_URL=http://localhost:8000
# SECRET_KEY=            # python -m weightroom.admin new-secrets
# ENCRYPTION_KEY=        # (same command)
# TRAINER=fake           # tinker in production
# STORAGE=local          # s3 in production
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_TOPUP=
# CREDIT_VALUE_USD=0.041

# Tinker (the trainer): https://tinker-console.thinkingmachines.ai -> API Keys
TINKER_API_KEY=

# Hugging Face write token, for the CLI's `trainloop fetch --hf-repo` (the service uses each customer's own token)
HF_TOKEN=

# --- Parked (CLI only) ----------------------------------------------------------------------------
# Fireworks: https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=
FIREWORKS_ACCOUNT_ID=

# OpenRouter: `trainloop prepare` (documents -> examples) and the Scorecard's optional judge.
# Requests are pinned to zero-data-retention providers because they carry customer content.
OPENROUTER_API_KEY=
# GENERATOR_MODEL=
# AGENT_MODEL=z-ai/glm-5.3

# OpenAI (writes training examples from documents; test documents only)
OPENAI_API_KEY=
